# Copy this file to ".env" and fill it in. Never share or commit .env: it holds secrets.

# --- Database (XAMPP MySQL: user root, empty password) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=payguard
DB_USER=root
DB_PASS=

# --- Payment mode ---
# true  = built-in simulator (no internet, has a failure dropdown)
# false = real Safaricom Daraja API (fill in the section below)
USE_SIMULATOR=true

# --- Daraja (developer.safaricom.co.ke > My Apps) ---
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
# CustomerPayBillOnline for a Paybill, CustomerBuyGoodsOnline for a Till number
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
# Till number only: set DARAJA_TRANSACTION_TYPE=CustomerBuyGoodsOnline, put your store number in DARAJA_SHORTCODE
# and your till number here. Leave blank for Paybill / sandbox.
DARAJA_TILL_NUMBER=
# Public https address of this site's folder, reachable by Safaricom (ngrok while testing), no trailing slash.
# Example: https://abc123.ngrok-free.app/payguard
PUBLIC_BASE_URL=
# Secret part of the callback address. Make one with:  php -r "echo bin2hex(random_bytes(16));"
MPESA_CALLBACK_TOKEN=
# Only if cURL says "SSL certificate problem": full path to a cacert.pem file (see docs/GUIDE.md)
CA_BUNDLE=

# --- First staff login (used once by tools/setup.php). Leave the password blank to get a random one. ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
